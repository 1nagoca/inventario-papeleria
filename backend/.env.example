# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Puerto donde corre el servidor Express
PORT=3000

# Clave compartida para usar la app (frontend y llamadas directas a la API).
# Sin esta variable configurada, TODAS las rutas de /api quedan bloqueadas.
APP_PASSWORD="cambia-esta-clave"
# --- Bot de WhatsApp (ver README, sección "Bot de WhatsApp") ---
# Sin estas variables el webhook /api/whatsapp/webhook rechaza todo.

# Palabra inventada por ti; se escribe igual al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN="inventa-una-frase-larga"
# "App Secret" de la app de Meta (App settings -> Basic). Firma cada mensaje.
META_APP_SECRET="app-secret-de-meta"
# Token de acceso de la WhatsApp Cloud API (para responder mensajes).
WHATSAPP_TOKEN="token-de-meta"
# "Phone number ID" del número de WhatsApp del bot (no es el número en sí).
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# Únicos números que el bot atiende: código de país + número, sin "+", sin
# espacios, separados por coma.
WHATSAPP_NUMEROS_AUTORIZADOS="573001234567,573109876543"
# Clave de la API de Claude (console.anthropic.com) para interpretar mensajes.
ANTHROPIC_API_KEY="sk-ant-..."
